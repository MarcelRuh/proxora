{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxora",
  "version": "2.5.0",
  "identifier": "app.proxora.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Proxora Proxmox management client",
    "longDescription": "Desktop WebView shell for your self-hosted Proxora instance.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMUIyN0NDNDA0N0Q4MkUKUldRdTJFZEF6Q2NiWWYwa2lYZ1p3c2V6a2dkZmtRWjExakRvU0JSTjU5ZGJyUjlieGxwaFV0MEIK",
      "endpoints": [
        "https://github.com/MarcelRuh/proxora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
