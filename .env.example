# Application
APP_URL=http://192.168.178.10:3000
# Extra CSRF origins (comma-separated)
# APP_ALLOWED_ORIGINS=
# Force Secure cookies (default: only when APP_URL is https://)
# COOKIE_SECURE=false
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
WS_PORT=3001
APP_VERSION=1.0.87

# PostgreSQL
DATABASE_URL=postgresql://proxora:proxora@localhost:5432/proxora?schema=public
POSTGRES_USER=proxora
POSTGRES_PASSWORD=proxora
POSTGRES_DB=proxora

# Must be at least 32 characters. Prefer 64 hex chars (32 bytes).
ENCRYPTION_KEY=change-me-to-a-long-random-secret-key
SESSION_SECRET=change-me-to-another-long-random-secret
SESSION_DAYS=7

# Bootstrap admin created by `npx prisma db seed`
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme-now
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# Browser WebSocket endpoint. Leave empty to use the current host.
NEXT_PUBLIC_WS_URL=

# Self-update (Compose install)
PROXORA_INSTALL_DIR=/opt/proxora
PROXORA_UPDATE_SIGNAL_DIR=/update-signal
PROXORA_REPO=MarcelRuh/proxora
PROXORA_BRANCH=main
# Optional: GitHub token to avoid anonymous rate limits
# GITHUB_TOKEN=
