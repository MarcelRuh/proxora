{
  "name": "proxora",
  "version": "1.2.3",
  "private": true,
  "description": "Proxora – central management for independent Proxmox VE hosts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcelRuh/proxora.git"
  },
  "homepage": "https://github.com/MarcelRuh/proxora",
  "scripts": {
    "dev": "concurrently -k \"next dev --turbopack\" \"tsx server/ws/standalone.ts\"",
    "dev:web": "next dev --turbopack",
    "dev:ws": "tsx server/ws/standalone.ts",
    "build": "prisma generate && next build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs --tsconfig=tsconfig.json",
    "start": "node dist/server.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@novnc/novnc": "^1.6.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.102.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "undici": "^8.10.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
